# Example configuration for Frigate Notification App
# Copy this to your AppDaemon conf directory and customize

frigate_notify:
  module: i1_frigate_notifier
  class: FrigateNotification

  # MQTT Configuration
  mqtt_topic: "frigate/events"

  # Frigate Configuration
  frigate_url: "https://your-frigate-instance.com/api/events"
  ext_domain: "https://your-external-domain.com"

  # Storage Configuration
  #
  # This is the path inside the APPDAEMON container, and it can be anything --
  # the constraint that matters is on the Home Assistant side.
  #
  # Home Assistant must NOT mount the same host directory anywhere under
  # /config. A backup archives /config, and from inside the container a bind
  # mount is just a directory, so the backup walks straight into it. On this
  # deployment the store is one host directory shared by both containers:
  #
  #   /mnt/storage/frigate_snapshots_appdaemon
  #       -> appdaemon    /snapshots        (rw)
  #       -> homeassistant /media/frigate   (ro)   <- was /config/www/frigate
  #
  # While it was mounted at /config/www/frigate, every automatic backup came to
  # 19.5 GB (measured 2026-08-31) -- far over Nabu Casa's per-backup limit,
  # which is why no offsite backup had ever run. The files never moved; only
  # Home Assistant's mount point did.
  snapshot_dir: "/snapshots"

  # The snapshot in the notification is served by Frigate's Home Assistant
  # integration, NOT from snapshot_dir:
  #   <ext_domain>/api/frigate/<frigate_client_id>/notifications/<event_id>/snapshot.jpg
  # That path is unauthenticated by design, which is what makes it usable from a
  # phone. The Video action uses the same base path.
  #
  # Do not point the image at /media or any authenticated path. Verified
  # 2026-09-01: /media returns 401 anonymously and the companion app does not
  # authenticate it, so notifications arrive with a BLANK IMAGE and nothing
  # errors anywhere.
  #
  # Optional; defaults to "frigate", which is the integration's default client id.
  frigate_client_id: frigate

  # Filtering Options
  only_zones: true  # Only notify when objects enter zones

  # Advanced Settings

  # Retention: TEN YEARS for images and video alike. This matches Frigate's own
  # `snapshots.retain.objects.person: 3600` and is deliberate. Event media here is
  # kept as a record; do not lower these without asking.
  max_file_age_days: 3650    # snapshot images (.jpg/.png/...)
  max_video_age_days: 3650   # clips (.mp4/.webm/...); set to null to keep forever
  cache_ttl_hours: 24      # Hours to keep cache entries
  connection_timeout: 30   # Connection timeout in seconds

  # Face Detection Settings
  face_detection_enabled: true    # Enable/disable face detection features
  face_detection_threshold: 0.7   # Minimum confidence threshold for face detection (0.0-1.0)

  # User Notifications
  persons:
    - name: "Primary User"
      notify: "mobile_app_primary_phone"
      labels:
        - "person"
        - "car"
        - "truck"
      cooldown: 120  # 2 minutes
      zones:
        - "driveway"
        - "front_door"
        - "backyard"
      cameras:
        - "doorbell_cam"
        - "driveway_cam"
        - "backyard_cam"

    - name: "Secondary User"
      notify: "mobile_app_secondary_phone"
      labels:
        - "person"
      cooldown: 300  # 5 minutes
      # No zone/camera filters - will receive all person events

    - name: "Emergency Contact"
      notify: "notify.telegram"
      labels:
        - "person"
        - "car"
        - "truck"
        - "bicycle"
      cooldown: 60  # 1 minute
      zones:
        - "driveway"
        - "front_door"
      cameras:
        - "doorbell_cam"
        - "driveway_cam"

    - name: "Night Watch"
      notify: "mobile_app_night_phone"
      labels:
        - "person"
        - "car"
      cooldown: 180  # 3 minutes
      zones:
        - "driveway"
        - "side_yard"
      cameras:
        - "driveway_cam"
        - "side_yard_cam"

  # Camera Icons (optional)
  cam_icons:
    doorbell_cam: "mdi:doorbell-video"
    driveway_cam: "mdi:car-estate"
    backyard_cam: "mdi:home-group"
    front_yard_cam: "mdi:home-variant"
    garage_cam: "mdi:garage"
    side_yard_cam: "mdi:fence"

  # Seconds to spend on the image ladder before giving up and notifying without
  # a picture. Default 15.
  #
  # The ladder tries, best first: the event's snapshot.jpg (only when the MQTT
  # payload's has_snapshot is true), then the event's thumbnail.jpg (~6 KB and
  # available earlier), then /api/<camera>/latest.jpg, which always exists. All
  # three answer in 11-17 ms on this Frigate, so three attempts cost nothing
  # perceptible and the alert is far better with a full-frame picture than with
  # none.
  #
  # There is no size floor any more. MIN_FILE_SIZE_BYTES = 50000 rejected six
  # complete doorbell snapshots on 2026-09-04 alone -- doorbell_cam detects at
  # 640x360, where a JPEG lands at 20-45 KB. Validation is now structural: SOI,
  # an end-of-image marker, and the body length against Content-Length.
  # media_timeout: 15

  # WHEN to notify, per camera. Default `end`, which is exactly today's
  # behaviour, so this is inert until a camera is named.
  #
  #   end  — notify when Frigate closes the event. Frigate closes it when the
  #          object is GONE, so on a doorbell the alert arrives after the
  #          visitor has given up and walked away.
  #   new  — notify as the event opens.
  #
  # Per camera on purpose: `new` on twelve cameras is a different product,
  # `new` on the doorbell is the fix. It is also the cheapest revert there is —
  # a config edit, not a deploy.
  #
  # In `new` mode every message for the event is admitted and the existing
  # duplicate guard makes sure only one notification goes out. That is
  # deliberate: filtering to the `new` message alone would mean that if it were
  # dropped for any other reason — no zone entered yet, nobody home — the event
  # would be unreachable for the rest of its life.
  notify_on:
    doorbell_cam: new

  # Applies to any camera not named above.
  # default_notify_on: end

  # NOTE on only_zones: with `new` it also considers `current_zones`, not only
  # `entered_zones`. entered_zones fills in as an object CROSSES into a zone and
  # is usually still empty on an early message, so checking it alone would make
  # `new` mode quieter than `end` rather than faster.

  # How often one event may improve its own notification.
  #
  # Every notification carries a per-event `tag`, so the companion app REPLACES
  # the earlier one rather than stacking a second. The household gets "person at
  # the front door" immediately and it becomes "Anders at the front door" with a
  # better picture — one notification that changes.
  #
  # Only two things earn a re-send: a face was recognised, or the detection
  # score improved by at least `score_improvement`. Frigate emits `update`
  # continuously while an object is in frame, so without that gate one visitor
  # becomes a stream — and a fast notification that spams is worse than the slow
  # one it replaced.
  #
  # max_notification_updates: 2      # 0 = never improve; send once and stop
  # score_improvement: 0.15
