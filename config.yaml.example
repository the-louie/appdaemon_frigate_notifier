# Example configuration for Frigate Notification App
# Copy this to your AppDaemon conf directory and customize

frigate_notify:
  module: i1_frigate_notifier
  class: FrigateNotification

  # MQTT Configuration
  mqtt_topic: "frigate/events"

  # Frigate Configuration
  frigate_url: "https://your-frigate-instance.com/api/events"
  ext_domain: "https://your-external-domain.com"

  # Storage Configuration
  #
  # This is the path inside the APPDAEMON container, and it can be anything --
  # the constraint that matters is on the Home Assistant side.
  #
  # Home Assistant must NOT mount the same host directory anywhere under
  # /config. A backup archives /config, and from inside the container a bind
  # mount is just a directory, so the backup walks straight into it. On this
  # deployment the store is one host directory shared by both containers:
  #
  #   /mnt/storage/frigate_snapshots_appdaemon
  #       -> appdaemon    /snapshots        (rw)
  #       -> homeassistant /media/frigate   (ro)   <- was /config/www/frigate
  #
  # While it was mounted at /config/www/frigate, every automatic backup came to
  # 19.5 GB (measured 2026-08-31) -- far over Nabu Casa's per-backup limit,
  # which is why no offsite backup had ever run. The files never moved; only
  # Home Assistant's mount point did.
  snapshot_dir: "/snapshots"

  # The snapshot in the notification is served by Frigate's Home Assistant
  # integration, NOT from snapshot_dir:
  #   <ext_domain>/api/frigate/<frigate_client_id>/notifications/<event_id>/snapshot.jpg
  # That path is unauthenticated by design, which is what makes it usable from a
  # phone. The Video action uses the same base path.
  #
  # Do not point the image at /media or any authenticated path. Verified
  # 2026-09-01: /media returns 401 anonymously and the companion app does not
  # authenticate it, so notifications arrive with a BLANK IMAGE and nothing
  # errors anywhere.
  #
  # Optional; defaults to "frigate", which is the integration's default client id.
  frigate_client_id: frigate

  # Filtering Options
  only_zones: true  # Only notify when objects enter zones

  # Advanced Settings
  max_file_age_days: 30    # Days to keep video files before cleanup
  cache_ttl_hours: 24      # Hours to keep cache entries
  connection_timeout: 30   # Connection timeout in seconds

  # Face Detection Settings
  face_detection_enabled: true    # Enable/disable face detection features
  face_detection_threshold: 0.7   # Minimum confidence threshold for face detection (0.0-1.0)

  # User Notifications
  persons:
    - name: "Primary User"
      notify: "mobile_app_primary_phone"
      labels:
        - "person"
        - "car"
        - "truck"
      cooldown: 120  # 2 minutes
      zones:
        - "driveway"
        - "front_door"
        - "backyard"
      cameras:
        - "doorbell_cam"
        - "driveway_cam"
        - "backyard_cam"

    - name: "Secondary User"
      notify: "mobile_app_secondary_phone"
      labels:
        - "person"
      cooldown: 300  # 5 minutes
      # No zone/camera filters - will receive all person events

    - name: "Emergency Contact"
      notify: "notify.telegram"
      labels:
        - "person"
        - "car"
        - "truck"
        - "bicycle"
      cooldown: 60  # 1 minute
      zones:
        - "driveway"
        - "front_door"
      cameras:
        - "doorbell_cam"
        - "driveway_cam"

    - name: "Night Watch"
      notify: "mobile_app_night_phone"
      labels:
        - "person"
        - "car"
      cooldown: 180  # 3 minutes
      zones:
        - "driveway"
        - "side_yard"
      cameras:
        - "driveway_cam"
        - "side_yard_cam"

  # Camera Icons (optional)
  cam_icons:
    doorbell_cam: "mdi:doorbell-video"
    driveway_cam: "mdi:car-estate"
    backyard_cam: "mdi:home-group"
    front_yard_cam: "mdi:home-variant"
    garage_cam: "mdi:garage"
    side_yard_cam: "mdi:fence"
